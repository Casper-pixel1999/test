# ─── Режим ──────────────────────────────────────────────────────────────
# true = бот только считает и шлёт алерты, ничего не покупает/не продаёт.
DRY_RUN=true
LOG_LEVEL=info

# ─── Steam ──────────────────────────────────────────────────────────────
STEAM_ACCOUNT_NAME=
# Пароль нужен только при первом входе: дальше используется refresh token.
STEAM_PASSWORD=
# Путь к зашифрованному maFile (см. npm run encrypt-mafile)
MAFILE_PATH=./data/account.maFile.enc
# Пароль расшифровки maFile и refresh-токена. Лучше передавать через секрет-менеджер,
# а не хранить в .env на диске.
SECRETS_PASSPHRASE=
REFRESH_TOKEN_PATH=./data/refresh_token.enc
# Валюта кошелька определяется автоматически при логоне; STEAM_CURRENCY — запасной вариант (1 = USD, 5 = RUB, 3 = EUR ...)
STEAM_CURRENCY=1
# Курс: сколько USD стоит 1 единица валюты кошелька. Обязателен, если кошелёк не в USD (RUB: ~0.011)
WALLET_USD_RATE=
# Один постоянный (sticky) прокси для всех АВТОРИЗОВАННЫХ запросов аккаунта.
# Резидентный/ISP прокси той же страны, что и аккаунт. Пусто = прямое соединение.
STEAM_ACCOUNT_PROXY=

# ─── Пул прокси для ПУБЛИЧНОГО парсинга цен (через запятую) ─────────────
PROXY_POOL=

# ─── Сторонние площадки ─────────────────────────────────────────────────
SKINPORT_ENABLED=true
SKINPORT_SELL_FEE_PCT=8
SKINPORT_CASHOUT_FEE_PCT=2

BUFF_ENABLED=false
# Cookie "session=..." из браузера (неофициальный API, только чтение цен)
BUFF_SESSION_COOKIE=
BUFF_SELL_FEE_PCT=2.5
BUFF_CASHOUT_FEE_PCT=1
CNY_USD_RATE=0.138

DMARKET_ENABLED=false
DMARKET_PUBLIC_KEY=
DMARKET_SECRET_KEY=
DMARKET_BUY_FEE_PCT=0
DMARKET_SELL_FEE_PCT=5
DMARKET_CASHOUT_FEE_PCT=2

# ─── Стратегия ──────────────────────────────────────────────────────────
APP_ID=730
WATCHLIST_PATH=./watchlist.json
# Минимальная чистая доходность (ROI) для автопокупки, %
MIN_ROI_PCT=10
# Сколько реальных денег стоит 1$ на кошельке Steam (кошелёк не выводится!)
STEAM_WALLET_VALUE=0.75
# Дисконт за риск падения цены во время 7-дневного холда, %
HOLD_RISK_PCT=3
MIN_STEAM_VOLUME_24H=20
MAX_ITEM_PRICE_USD=50
DAILY_BUDGET_USD=200
# Минимальная маржа над себестоимостью при автопродаже, %
MIN_SELL_MARGIN_PCT=5
# Отсечь сделку, если немедленная продажа в лучшую заявку даёт убыток больше этого, %
MAX_WORST_LOSS_PCT=10
# Отсечь сделку, если по объёму продаж лот уйдёт дольше, чем за N дней
MAX_DAYS_TO_SELL=3

# ─── Сканер: ступень 1 (широкий отбор) -> ступень 2 (глубокая проверка) ─
SCREEN_ENABLED=true
# Страниц поиска Steam по 100 предметов (самые популярные)
SCREEN_PAGES=10
SCREEN_MIN_LISTINGS=20
# Кандидат проходит в глубокую проверку, если грубый ROI >= MIN_ROI_PCT * factor
SCREEN_ROI_FACTOR=0.5
DEEP_CHECK_PER_CYCLE=15

# ─── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── БД ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://arb:arb@localhost:5432/arb
